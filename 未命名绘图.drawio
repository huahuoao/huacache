<mxfile host="app.diagrams.net">
    <diagram name="C/S架构系统设计">
        <mxGraphModel dx="1422" dy="792" grid="1" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                
                <!-- 核心存储节点 -->
                <mxCell id="core_storage" value="<b>核心存储节点</b><br>LSM-Tree架构<br>• MemTable写入优化<br>• SSTable分层存储<br>• Golang并发控制" 
                        style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" 
                        vertex="1" parent="1">
                    <mxGeometry x="400" y="300" width="240" height="120"/>
                </mxCell>
                
                <!-- 客户端 -->
                <mxCell id="client" value="<b>客户端</b><br>Golang网络库实现<br>• 高并发请求处理<br>• 智能请求路由<br>• 负载均衡策略" 
                        style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" 
                        vertex="1" parent="1">
                    <mxGeometry x="100" y="100" width="160" height="80"/>
                </mxCell>
                
                <!-- 服务端 -->
                <mxCell id="server" value="<b>服务端</b><br>gnet框架驱动<br>• 自定义通信协议<br>• 事件驱动架构<br>• 动态负载管理" 
                        style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" 
                        vertex="1" parent="1">
                    <mxGeometry x="700" y="100" width="160" height="80"/>
                </mxCell>
                
                <!-- 服务注册中心 -->
                <mxCell id="etcd" value="<b>服务注册中心</b><br>etcd组件<br>• 服务发现机制<br>• 健康状态监控<br>• 动态配置更新" 
                        style="shape=ellipse;whiteSpace=wrap;html=fillColor=#dae8fc;strokeColor=#6c8ebf;" 
                        vertex="1" parent="1">
                    <mxGeometry x="400" y="50" width="160" height="80"/>
                </mxCell>
                
                <!-- 数据流向 -->
                <mxCell id="conn1" value="" style="endArrow=classic;html=1;strokeWidth=2;" 
                        edge="1" parent="1" source="client" target="core_storage">
                    <mxGeometry width="50" relative="1" as="geometry">
                        <mxPoint x="180" y="140" as="sourcePoint"/>
                        <mxPoint x="400" y="300" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                
                <mxCell id="conn2" value="" style="endArrow=classic;html=1;strokeWidth=2;" 
                        edge="1" parent="1" source="server" target="core_storage">
                    <mxGeometry width="50" relative" as="geometry">
                        <mxPoint x="780" y="140" as="sourcePoint"/>
                        <mxPoint x="640" y="300" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                
                <mxCell id="conn3" value="服务注册" style="endArrow=classic;html=1;dashed=1;" 
                        edge="1" parent="1" source="etcd" target="client">
                    <mxGeometry width="50" relative="1" as="geometry">
                        <mxPoint x="480" y="50" as="sourcePoint"/>
                        <mxPoint x="260" y="100" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                
                <mxCell id="conn4" value="服务发现" style="endArrow=classic;html=1;dashed=1;" 
                        edge="1" parent="1" source="etcd" target="server">
                    <mxGeometry width="50" relative="1" as="geometry">
                        <mxPoint x="480" y="130" as="sourcePoint"/>
                        <mxPoint x="860" y="100" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
            </mxGraphModel>
        </diagram>
    </mxfile>
